{
  "name": "@docx-pages/pdf",
  "description": "Write a .docx laid out by @docx-pages/core to a PDF. Isomorphic, and measured against Word.",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*",
    "!dist/testing",
    "!src/testing"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@docx-pages/core": "workspace:*",
    "fflate": "^0.8.3"
  },
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "layout",
    "pagination",
    "office",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jproberson/docx-pages.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/jproberson/docx-pages#readme",
  "bugs": {
    "url": "https://github.com/jproberson/docx-pages/issues"
  }
}
