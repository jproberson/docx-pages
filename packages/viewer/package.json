{
  "name": "@docx-pages/viewer",
  "description": "React components that draw a page laid out by @docx-pages/core.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*",
    "!dist/testing",
    "!src/testing"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@docx-pages/core": "workspace:*",
    "@docx-pages/fonts": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "layout",
    "pagination",
    "office",
    "react"
  ]
}
