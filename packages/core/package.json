{
  "name": "@docx-pages/core",
  "description": "Lay out a .docx the way Word does, page by page. Isomorphic, and measured against Word.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!src/**/*.test.*",
    "!dist/testing",
    "!src/testing"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3"
  },
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "layout",
    "pagination",
    "office"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jproberson/docx-pages.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jproberson/docx-pages#readme",
  "bugs": {
    "url": "https://github.com/jproberson/docx-pages/issues"
  }
}
