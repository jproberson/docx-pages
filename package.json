{
  "name": "docx-onepager-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "preview": "pnpm typecheck && node packages/render/dist/preview/write.js",
    "browse": "pnpm preview && python3 -m http.server 8787 --directory samples/preview",
    "fonts": "pnpm typecheck && node packages/render/dist/fonts/report.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
